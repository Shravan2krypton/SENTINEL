# Sentinel CCTV Intelligence Platform Configuration Example
ENVIRONMENT=development
PROJECT_NAME="Sentinel CCTV Intelligence Platform"
API_V1_STR=/api
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL + PostGIS
DATABASE_URL=postgresql://user:password@localhost:5432/sentinel_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Sentinel Gateway
SENTINEL_GATEWAY_URL=http://localhost:8000/api/ingest
SENTINEL_SYNC_INTERVAL_SECONDS=60

# RTSP Stream Settings
RTSP_TRANSPORT=tcp
STREAM_RECONNECT_MAX_BACKOFF=30
FRAME_SAMPLE_INTERVAL=3

# AI Settings
YOLO_MODEL=yolov8n.pt
DETECTION_CONFIDENCE_THRESHOLD=0.35
ANPR_CONFIDENCE_THRESHOLD=0.60
DEVICE=cpu
